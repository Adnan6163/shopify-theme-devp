{%- for block in section.blocks -%}
  <div class="{{section.settings.text-align}}" style="background-color: {{block.settings.bg-color}}; color :{{block.settings.text-color}};">
    {{block.settings.rich-text}}
  </div>
{%- endfor -%}
{% schema %}
  {
    "name": "Announcement bar",
    "max_blocks": 12,
    "class": "announcement-bar-section",
    "enabled_on": {
      "groups": ["header"]
    },
    "settings": [
     {
       "type": "select",
       "id": "text-align",
       "label": "Text Alignment",
       "options": [
         {
           "value": "text-left",
           "label": "Left"
         },
         {
           "value": "text-center",
           "label": "Center"
         },
         {
           "value": "text-right",
           "label": "Right"
         }
       ],
       "default": "text-left"
     }
    ],
    "blocks": [
      {
        "type": "announcement",
        "name": "t:sections.announcement-bar.blocks.announcement.name",
        "settings": [
          {
            "type": "richtext",
            "id": "rich-text",
            "label": "Text",
            "default": "<p>Welcome to our store!</p>"
          },
          {
            "type": "color",
            "id": "bg-color",
            "label": "Background Color",
            "default": "#fff"
          },
          {
            "type": "color",
            "id": "text-color",
            "label": "Color",
            "default": "#000000"
          },
        ]
      }
    ],
    "presets": [
      {
        "name": "t:sections.announcement-bar.presets.name",
        "blocks": [
          {
            "type": "announcement"
          }
        ]
      }
    ]
  }
{% endschema %}